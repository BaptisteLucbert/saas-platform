{% extends 'base.html.twig' %}

{% block title %}Dashboard Vinted – ProfitPulse{% endblock %}

{% block body %}
<div class="dashboard-layout">
    {{ include('dashboard/_sidebar.html.twig') }}

    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <h1 class="dashboard-title">Dashboard Vinted <span class="badge badge-primary">PRO</span></h1>
                <p class="dashboard-subtitle">Gérez vos bots de sniping et vos comptes Vinted</p>
            </div>
            <div style="display:flex; gap:0.75rem;">
                <button class="btn btn-ghost">Logs en direct</button>
                <button class="btn btn-primary">+ Ajouter un compte</button>
            </div>
        </div>

        {# Vinted Stats #}
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-card-icon" style="background:rgba(124,58,237,0.2);">🛍️</div>
                <div class="stat-card-value">12</div>
                <div class="stat-card-label">Articles snipés (24h)</div>
                <div class="stat-card-trend trend-up">↑ 14% vs hier</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon" style="background:rgba(16,185,129,0.2);">👤</div>
                <div class="stat-card-value">3 / 5</div>
                <div class="stat-card-label">Comptes actifs</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon" style="background:rgba(6,182,212,0.2);">🛰️</div>
                <div class="stat-card-value">99.9%</div>
                <div class="stat-card-label">Uptime Proxys</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-icon" style="background:rgba(245,158,11,0.2);">⚡</div>
                <div class="stat-card-value">450ms</div>
                <div class="stat-card-label">Latence moyenne</div>
            </div>
        </div>

        <div class="vinted-grid">
            {# Gestion des comptes #}
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Mes Comptes Vinted</h2>
                </div>
                <div class="card-body">
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Compte</th>
                                    <th>Statut</th>
                                    <th>Proxys</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>vinted_user_1</strong></td>
                                    <td><span class="status status-active">Connecté</span></td>
                                    <td>Paris-FR-01</td>
                                    <td><button class="btn btn-ghost btn-sm">⚙️</button></td>
                                </tr>
                                <tr>
                                    <td><strong>fashion_resell_pro</strong></td>
                                    <td><span class="status status-active">Connecté</span></td>
                                    <td>Berlin-DE-04</td>
                                    <td><button class="btn btn-ghost btn-sm">⚙️</button></td>
                                </tr>
                                <tr>
                                    <td><strong>test_account_88</strong></td>
                                    <td><span class="status status-cancelled">Erreur Auth</span></td>
                                    <td>London-UK-02</td>
                                    <td><button class="btn btn-primary btn-sm">Reconnecter</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {# Filtres actifs #}
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Filtres de Sniping</h2>
                    <button class="btn btn-ghost btn-sm">Gérer les filtres</button>
                </div>
                <div class="card-body">
                    <div style="display:flex; flex-direction:column; gap:1rem;">
                        <div style="padding:1rem; background:rgba(255,255,255,0.03); border:1px solid var(--color-border); border-radius:12px; display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <div style="font-weight:700;">Nike Tech Fleece</div>
                                <div style="font-size:0.75rem; color:var(--color-text-faint);">Prix < 40€ · État: Neuf/Très bon</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                        <div style="padding:1rem; background:rgba(255,255,255,0.03); border:1px solid var(--color-border); border-radius:12px; display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <div style="font-weight:700;">Jordan 4 SB Pine Green</div>
                                <div style="font-size:0.75rem; color:var(--color-text-faint);">Prix < 350€ · Taille: 42-44</div>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Logs en temps réel #}
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Flux de détection en direct</h2>
                <span class="status status-active">Live Monitoring</span>
            </div>
            <div class="card-body" style="background:#07080f; padding:0;">
                <div style="height:300px; overflow-y:auto; padding:1.5rem; font-family:'Courier New', monospace; font-size:0.8rem; line-height:1.6;">
                    <div style="color:var(--color-text-faint);">[01:12:44] Bot started... scanning proxies...</div>
                    <div style="color:var(--color-success);">[01:12:45] Authentication success for vinted_user_1</div>
                    <div style="color:var(--color-info);">[01:13:02] Search triggered: "Nike Tech Fleece" - 42 items found</div>
                    <div style="color:var(--color-warning);">[01:13:05] Item #823491 filtered: Price too high (55.00 EUR)</div>
                    <div style="color:var(--color-info);">[01:13:12] Search triggered: "Jordan 4" - 12 items found</div>
                    <div style="color:var(--color-success); font-weight:700;">[01:14:22] SNIPE DETECTED: "Nike Tech Fleece" - 25.00 EUR - Buying...</div>
                    <div style="color:var(--color-success); font-weight:700;">[01:14:25] PURCHASE SUCCESS: Order #V-734102 confirmed</div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
