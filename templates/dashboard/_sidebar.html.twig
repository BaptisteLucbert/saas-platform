<aside class="sidebar">
    <div class="sidebar-top">
        <a href="{{ path('app_home') }}" class="sidebar-brand">
            <span class="brand-icon">⚡</span>
            <span class="brand-name">ProfitPulse</span>
        </a>
    </div>

    <div class="sidebar-content">
        <div class="sidebar-section">
            <div class="sidebar-label">Navigation</div>
            <nav class="sidebar-nav">
                <a href="{{ path('app_dashboard') }}" class="sidebar-link {{ app.request.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    Vue générale
                </a>
                <a href="{{ path('app_dashboard_subscriptions') }}" class="sidebar-link {{ app.request.get('_route') == 'app_dashboard_subscriptions' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    Mes abonnements
                </a>
                <a href="{{ path('app_dashboard_discord') }}" class="sidebar-link {{ app.request.get('_route') == 'app_dashboard_discord' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Connexion Discord
                </a>
                {% if app.user.hasActiveSubscriptionForService('vinted') %}
                <a href="{{ path('app_dashboard_vinted') }}" class="sidebar-link {{ app.request.get('_route') == 'app_dashboard_vinted' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    Dashboard Vinted
                    <span class="badge badge-primary" style="margin-left:auto;">PRO</span>
                </a>
                {% endif %}
                <a href="{{ path('app_dashboard_invoices') }}" class="sidebar-link {{ app.request.get('_route') == 'app_dashboard_invoices' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    Factures
                </a>
            </nav>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-label">Compte</div>
            <nav class="sidebar-nav">
                <a href="{{ path('app_dashboard_settings') }}" class="sidebar-link {{ app.request.get('_route') == 'app_dashboard_settings' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    Paramètres
                </a>
                <a href="{{ path('app_dashboard_security') }}" class="sidebar-link {{ app.request.get('_route') starts with 'app_dashboard_security' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    Sécurité
                </a>
            </nav>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
        <div class="sidebar-section">
            <div class="sidebar-label">Administration</div>
            <nav class="sidebar-nav">
                <a href="{{ path('app_admin_dashboard') }}" class="sidebar-link" style="color: var(--color-error);">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    Admin Panel
                </a>
            </nav>
        </div>
        {% endif %}
    </div>

    <div class="sidebar-footer">
        <div class="user-profile">
            <div class="user-avatar">
                {{ app.user.firstName ? app.user.firstName|first|upper : app.user.email|first|upper }}
            </div>
            <div class="user-info">
                <div class="user-name">{{ app.user.firstName ?? app.user.email|split('@')|first }}</div>
                <div class="user-email">{{ app.user.email }}</div>
            </div>
        </div>
        <form action="{{ path('app_logout') }}" method="post" style="margin: 0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Déconnexion
            </button>
        </form>
    </div>
</aside>
