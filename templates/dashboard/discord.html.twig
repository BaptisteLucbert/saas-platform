{% extends 'base_dashboard.html.twig' %}

{% block title %}Connexion Discord – ProfitPulse{% endblock %}

{% block body %}
<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">Paramètres Discord</h1>
        <p class="dashboard-subtitle">Connectez votre compte pour accéder aux salons premium</p>
    </div>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <div style="text-align:center; padding: 2rem 0;">
            <div style="width:80px; height:80px; background:#5865F2; border-radius:100px; display:flex; align-items:center; justify-content:center; margin: 0 auto 1.5rem;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="white"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037 19.736 19.736 0 0 0-4.885 1.515.069.069 0 0 0-.032.027C.533 9.048-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
            </div>
            <h2>Rejoignez la communauté</h2>
            <p style="color:var(--color-text-muted); margin-bottom: 2rem;">
                Une fois connecté, le bot vous attribuera automatiquement les rôles correspondant à vos abonnements actifs.
            </p>
            <button class="btn btn-xl" style="background:#5865F2; color:white; width:100%; justify-content:center;">
                Lier mon compte Discord
            </button>
            <div style="margin-top:1.5rem; font-size:0.8rem; color:var(--color-text-faint);">
                Nous ne collectons que votre ID Discord pour la gestion des rôles.
            </div>
        </div>
    </div>
</div>

<div class="card" style="max-width: 600px;">
    <div class="card-header"><h2 class="card-title">Services reliés</h2></div>
    <div class="card-body">
        <div style="display:flex; flex-direction:column; gap:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span>Salons Pronostics Sportifs</span>
                <span class="status status-cancelled">Accès Refusé</span>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span>Salons Amazon Deals</span>
                <span class="status status-cancelled">Accès Refusé</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
