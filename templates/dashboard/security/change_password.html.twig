{% extends 'base_dashboard.html.twig' %}

{% block title %}Changer le mot de passe – ProfitPulse{% endblock %}

{% block body %}
<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">Changer le mot de passe</h1>
        <p class="dashboard-subtitle">Assurez la sécurité de votre compte avec un mot de passe robuste</p>
    </div>
</div>

<div class="auth-card" style="margin: 0; max-width: 500px;">
    <form method="post">
        <div class="form-group">
            <label class="form-label" for="current_password">Mot de passe actuel</label>
            <input type="password" id="current_password" name="current_password" class="form-control" required placeholder="••••••••••">
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Nouveau mot de passe</label>
            <input type="password" id="password" name="password" class="form-control" required placeholder="••••••••••" minlength="10">
            <div style="margin-top:8px;">
                <div style="background:var(--color-border); border-radius:99px; height:4px; overflow:hidden;">
                    <div id="password-strength" style="height:100%; width:0%; border-radius:99px; transition:all 0.3s;"></div>
                </div>
                <span id="password-strength-label" style="font-size:11px; font-weight:600; margin-top:4px; display:block;"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="password_confirm">Confirmer le nouveau mot de passe</label>
            <input type="password" id="password_confirm" name="password_confirm" class="form-control" required placeholder="••••••••••">
        </div>

        <button type="submit" class="btn btn-primary btn-xl" style="width:100%; justify-content:center;">
            Mettre à jour le mot de passe
        </button>
    </form>
</div>
{% endblock %}
