{% extends 'base_admin.html.twig' %}

{% block title %}Paiements – Admin{% endblock %}

{% block body %}
<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">Historique des Paiements</h1>
        <p class="dashboard-subtitle">Monitoring des transactions Whop</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Montant</th>
                        <th>Whop ID</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in payments %}
                    <tr>
                        <td>{{ payment.createdAt|date('d/m/Y H:i') }}</td>
                        <td>{{ payment.user.email }}</td>
                        <td><strong>{{ payment.amount }} {{ payment.currency|upper }}</strong></td>
                        <td style="font-size:0.75rem; color:var(--color-text-faint);">{{ payment.whopPaymentId }}</td>
                        <td>
                            <span class="status status-{{ payment.status }}">
                                {{ payment.status|capitalize }}
                            </span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
