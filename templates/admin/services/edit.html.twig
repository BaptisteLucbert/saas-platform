{% extends 'base_admin.html.twig' %}

{% block title %}Modifier Service – {{ service.name }}{% endblock %}

{% block body %}
<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">Modifier : {{ service.name }}</h1>
        <p class="dashboard-subtitle">Ajustez les paramètres et les intégrations Whop</p>
    </div>
    <a href="{{ path('app_admin_services') }}" class="btn btn-ghost">← Retour</a>
</div>

<div class="card" style="max-width: 800px;">
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('edit_service_' ~ service.id) }}">
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Nom du Service</label>
                    <input type="text" name="name" class="form-control" value="{{ service.name }}" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Prix Mensuel (€)</label>
                    <input type="number" step="0.01" name="monthlyPrice" class="form-control" value="{{ service.monthlyPrice }}" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Prix Annuel (€)</label>
                    <input type="number" step="0.01" name="annualPrice" class="form-control" value="{{ service.annualPrice }}" required>
                </div>

                <div style="grid-column: span 2; padding-top: 1.5rem; border-top: 1px solid var(--color-border); margin-top: 1rem;">
                    <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem; color: var(--color-primary-light);">Configuration Whop</h3>
                </div>

                <div class="form-group">
                    <label class="form-label">Whop Monthly Plan ID (PROD)</label>
                    <input type="text" name="whopMonthlyPlanId" class="form-control" value="{{ service.whopMonthlyPlanId }}">
                </div>

                <div class="form-group">
                    <label class="form-label">Whop Monthly Plan ID (SANDBOX)</label>
                    <input type="text" name="whopMonthlyPlanIdSandbox" class="form-control" value="{{ service.whopMonthlyPlanIdSandbox }}">
                </div>

                <div class="form-group">
                    <label class="form-label">Whop Annual Plan ID (PROD)</label>
                    <input type="text" name="whopAnnualPlanId" class="form-control" value="{{ service.whopAnnualPlanId }}">
                </div>

                <div class="form-group">
                    <label class="form-label">Whop Annual Plan ID (SANDBOX)</label>
                    <input type="text" name="whopAnnualPlanIdSandbox" class="form-control" value="{{ service.whopAnnualPlanIdSandbox }}">
                </div>
            </div>

            <div style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); display: flex; gap: 1rem;">
                <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                <a href="{{ path('app_admin_services') }}" class="btn btn-ghost">Annuler</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
