<aside class="sidebar admin-sidebar">
    <div class="sidebar-top">
        <a href="{{ path('app_admin_dashboard') }}" class="sidebar-brand">
            <span class="brand-icon">🛡️</span>
            <span class="brand-name">ADMIN PANEL</span>
        </a>
    </div>

    <div class="sidebar-content">
        <div class="sidebar-section">
            <div class="sidebar-label">Gestion</div>
            <nav class="sidebar-nav">
                <a href="{{ path('app_admin_dashboard') }}" class="sidebar-link {{ app.request.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    Vue d'ensemble
                </a>
                <a href="{{ path('app_admin_users') }}" class="sidebar-link {{ app.request.get('_route') starts with 'app_admin_user' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Utilisateurs
                </a>
                <a href="{{ path('app_admin_subscriptions') }}" class="sidebar-link {{ app.request.get('_route') == 'app_admin_subscriptions' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    Abonnements
                </a>
                <a href="{{ path('app_admin_payments') }}" class="sidebar-link {{ app.request.get('_route') == 'app_admin_payments' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                    Paiements
                </a>
                <a href="{{ path('app_admin_services') }}" class="sidebar-link {{ app.request.get('_route') starts with 'app_admin_service' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                    Services
                </a>
                <a href="{{ path('app_admin_logs') }}" class="sidebar-link {{ app.request.get('_route') == 'app_admin_logs' ? 'active' : '' }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    Logs Audit
                </a>
            </nav>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-label">Retour</div>
            <nav class="sidebar-nav">
                <a href="{{ path('app_dashboard') }}" class="sidebar-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Dashboard Utilisateur
                </a>
            </nav>
        </div>
    </div>

    <div class="sidebar-footer">
        <div class="user-profile">
            <div class="user-avatar" style="background: var(--color-error);">
                {{ app.user.email|first|upper }}
            </div>
            <div class="user-info">
                <div class="user-name">{{ app.user.email|split('@')|first }}</div>
                <div class="user-email">{{ app.user.email }}</div>
            </div>
        </div>
        <form action="{{ path('app_logout') }}" method="post" style="margin: 0;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Déconnexion
            </button>
        </form>
    </div>
</aside>
