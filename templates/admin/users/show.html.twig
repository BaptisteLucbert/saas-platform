{% extends 'base_admin.html.twig' %}

{% block title %}Profil : {{ user.email }} – Admin{% endblock %}

{% block body %}
<div class="dashboard-header">
    <div>
        <a href="{{ path('app_admin_users') }}" style="color:var(--color-text-faint); font-size:0.875rem; text-decoration:none;">← Retour à la liste</a>
        <h1 class="dashboard-title">{{ user.email }}</h1>
        <p class="dashboard-subtitle">ID Utilisateur : {{ user.id }}</p>
    </div>
    <div style="display:flex; gap:1rem;">
        <form action="{{ path('app_admin_user_suspend', {id: user.id}) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('suspend_user_' ~ user.id) }}">
            <button type="submit" class="btn {{ user.isSuspended ? 'btn-primary' : 'btn-danger' }}">
                {{ user.isSuspended ? 'Réactiver le compte' : 'Suspendre le compte' }}
            </button>
        </form>
        <form action="{{ path('app_admin_force_reset', {id: user.id}) }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('force_reset_' ~ user.id) }}">
            <button type="submit" class="btn btn-ghost" onclick="return confirm('Forcer le changement de mot de passe à la prochaine connexion ?')">
                Forcer Reset MDP
            </button>
        </form>
    </div>
</div>

<div class="vinted-grid">
    <div class="card">
        <div class="card-header"><h2 class="card-title">Détails du compte</h2></div>
        <div class="card-body">
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div>
                    <div style="font-size:0.75rem; color:var(--color-text-faint); text-transform:uppercase;">Email</div>
                    <div style="font-weight:700;">{{ user.email }}</div>
                </div>
                <div>
                    <div style="font-size:0.75rem; color:var(--color-text-faint); text-transform:uppercase;">Prénom / Nom</div>
                    <div style="font-weight:700;">{{ user.firstName|default('–') }} {{ user.lastName|default('–') }}</div>
                </div>
                <div>
                    <div style="font-size:0.75rem; color:var(--color-text-faint); text-transform:uppercase;">Rôles</div>
                    <div style="font-weight:700;">{{ user.roles|join(', ') }}</div>
                </div>
                <div>
                    <div style="font-size:0.75rem; color:var(--color-text-faint); text-transform:uppercase;">Must Reset Password</div>
                    <div style="font-weight:700;">{{ user.mustChangePassword ? 'OUI' : 'NON' }}</div>
                </div>
                <div>
                    <div style="font-size:0.75rem; color:var(--color-text-faint); text-transform:uppercase;">Whop User ID</div>
                    <div style="font-weight:700;">{{ user.whopUserId|default('–') }}</div>
                </div>
                <div>
                    <div style="font-size:0.75rem; color:var(--color-text-faint); text-transform:uppercase;">Créé le</div>
                    <div style="font-weight:700;">{{ user.createdAt|date('d/m/Y H:i') }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h2 class="card-title">Abonnements Actifs</h2></div>
        <div class="card-body">
            {% if user.subscriptions is empty %}
                <p style="color:var(--color-text-faint);">Aucun abonnement.</p>
            {% else %}
                <ul style="display:flex; flex-direction:column; gap:0.75rem; list-style:none; padding:0;">
                    {% for sub in user.subscriptions %}
                        <li style="padding:0.75rem; background:rgba(255,255,255,0.03); border:1px solid var(--color-border); border-radius:8px; display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <strong>{{ sub.service.name }}</strong>
                                <span class="status status-{{ sub.status }}" style="font-size:0.7rem; margin-left:0.5rem;">{{ sub.status }}</span>
                            </div>
                            <span style="font-weight:600;">{{ sub.amount }}€ / {{ sub.interval == 'monthly' ? 'mois' : 'an' }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
