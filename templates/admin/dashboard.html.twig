{% extends 'base_admin.html.twig' %}

{% block title %}Admin Dashboard – ProfitPulse{% endblock %}

{% block body %}
<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">Admin Dashboard</h1>
        <p class="dashboard-subtitle">Statistiques globales de la plateforme</p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-card-icon" style="background:rgba(124,58,237,0.2);">👥</div>
        <div class="stat-card-value">{{ stats.total_users }}</div>
        <div class="stat-card-label">Utilisateurs totaux</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon" style="background:rgba(16,185,129,0.2);">📦</div>
        <div class="stat-card-value">{{ stats.active_subscriptions }}</div>
        <div class="stat-card-label">Abos actifs</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-icon" style="background:rgba(245,158,11,0.2);">💳</div>
        <div class="stat-card-value">{{ stats.total_revenue }}€</div>
        <div class="stat-card-label">Revenu total</div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Derniers inscrits</h2>
    </div>
    <div class="card-body">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Date d'inscription</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in stats.recent_users %}
                    <tr>
                        <td>{{ user.email }}</td>
                        <td>{{ user.createdAt|date('d/m/Y H:i') }}</td>
                        <td>
                            {% if user.isSuspended %}
                                <span class="status status-cancelled">Suspendu</span>
                            {% else %}
                                <span class="status status-active">Actif</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_admin_user_show', {id: user.id}) }}" class="btn btn-ghost btn-sm">Gérer</a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
