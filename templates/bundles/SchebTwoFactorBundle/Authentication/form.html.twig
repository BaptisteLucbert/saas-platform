{% extends 'base.html.twig' %}

{% block title %}Vérification 2FA – ProfitPulse{% endblock %}

{% block body %}
<section class="auth-section">
    <div class="container" style="display:flex; justify-content:center; align-items:center; min-height:80vh;">
        <div class="auth-card" style="width:100%; max-width:450px;">
            <div class="auth-header" style="text-align:center; margin-bottom:2rem;">
                <div style="font-size:3rem; margin-bottom:1rem;">🛡️</div>
                <h1 class="auth-title">Vérification de sécurité</h1>
                <p class="auth-subtitle">Entrez le code généré par votre application Google Authenticator.</p>
            </div>

            <form action="{{ checkPath }}" method="post">
                {% if authenticationError %}
                    <div style="background:rgba(239, 68, 68, 0.1); border:1px solid rgba(239, 68, 68, 0.2); color:#ef4444; padding:0.75rem; border-radius:8px; margin-bottom:1.5rem; text-align:center; font-size:0.875rem;">
                        {{ authenticationErrorMsgKey|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
                    </div>
                {% endif %}

                <div class="form-group" style="margin-bottom:2rem;">
                    <label class="form-label" for="_auth_code" style="text-align:center; display:block;">Code de vérification</label>
                    <input type="text" id="_auth_code" name="_auth_code" class="form-control" autocomplete="one-time-code" autofocus required
                           style="text-align:center; font-size:2rem; letter-spacing:8px; font-weight:800; padding:1rem;"
                           placeholder="000000" maxlength="6">
                </div>

                <div style="display:flex; flex-direction:column; gap:1rem;">
                    <button type="submit" class="btn btn-primary btn-xl" style="width:100%; justify-content:center;">
                        Vérifier le code
                    </button>
                    
                    <a href="{{ path('app_logout') }}" class="btn btn-ghost" style="width:100%; justify-content:center; font-size:0.875rem;">
                        Annuler et se déconnecter
                    </a>
                </div>

                {# Display trust option if configured #}
                {% if displayTrustedOption %}
                    <div style="margin-top:1.5rem; display:flex; align-items:center; gap:0.5rem; justify-content:center;">
                        <input type="checkbox" id="_trusted" name="_trusted" style="width:16px; height:16px; accent-color:var(--color-primary);">
                        <label for="_trusted" style="font-size:0.875rem; color:var(--color-text-muted);">Faire confiance à cet appareil pendant 30 jours</label>
                    </div>
                {% endif %}
            </form>
        </div>
    </div>
</section>

<style>
    .auth-section {
        background: radial-gradient(circle at top right, rgba(124, 58, 237, 0.05), transparent),
                    radial-gradient(circle at bottom left, rgba(16, 185, 129, 0.05), transparent);
    }
</style>
{% endblock %}
