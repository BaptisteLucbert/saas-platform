{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe – ProfitPulse{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="hero-glow hero-glow-1" style="opacity:0.3"></div>
    <div class="auth-card">
        <div class="auth-card-header">
            <div class="auth-logo">🔐</div>
            <h1 class="auth-title">Nouveau mot de passe</h1>
            <p class="auth-subtitle">Choisissez un mot de passe fort et sécurisé.</p>
        </div>

        <form method="post">
            <div class="form-group">
                <label class="form-label" for="password">Nouveau mot de passe</label>
                <input type="password" id="password" name="password" class="form-control" required
                    placeholder="••••••••••" autocomplete="new-password" minlength="10">
                <div style="margin-top:8px;">
                    <div style="background:var(--color-border); border-radius:99px; height:4px; overflow:hidden;">
                        <div id="password-strength" style="height:100%; width:0%; border-radius:99px; transition:all 0.3s;"></div>
                    </div>
                    <span id="password-strength-label" style="font-size:11px; font-weight:600; margin-top:4px; display:block;"></span>
                </div>
                <span class="form-hint">Min. 10 caractères, 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial (@$!%*?&)</span>
            </div>

            <div class="form-group">
                <label class="form-label" for="password_confirm">Confirmer le mot de passe</label>
                <input type="password" id="password_confirm" name="password_confirm" class="form-control" required
                    placeholder="••••••••••" autocomplete="new-password">
            </div>

            <button type="submit" class="btn btn-primary auth-submit" id="password-reset-btn">
                Réinitialiser le mot de passe
            </button>
        </form>

        <div class="auth-footer">
            <a href="{{ path('app_login') }}">← Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
