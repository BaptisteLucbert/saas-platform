{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié – ProfitPulse{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="hero-glow hero-glow-1" style="opacity:0.3"></div>
    <div class="auth-card">
        <div class="auth-card-header">
            <div class="auth-logo">🔑</div>
            <h1 class="auth-title">Mot de passe oublié</h1>
            <p class="auth-subtitle">Entrez votre email pour recevoir un lien de réinitialisation.</p>
        </div>

        <form method="post">
            <div class="form-group">
                <label class="form-label" for="email">Adresse email</label>
                <input type="email" id="email" name="email" class="form-control" required
                    placeholder="vous@exemple.com" autocomplete="email">
                <span class="form-hint">Vous recevrez un email avec un lien valable 15 minutes.</span>
            </div>
            <button type="submit" class="btn btn-primary auth-submit" id="password-forgot-btn">
                Envoyer le lien de réinitialisation
            </button>
        </form>

        <div class="auth-footer">
            <a href="{{ path('app_login') }}">← Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
